@model SistemaEstoque.Models.LoginModel

<h1>Login</h1>

<form asp-action="Entrar" method="post">

    <div>
        <label>Usuário</label>
        <input asp-for="Usuario" />
    </div>

    <div>
        <label>Senha</label>
        <input asp-for="Senha" type="password" />
    </div>

    <button type="submit">Entrar</button>

</form>
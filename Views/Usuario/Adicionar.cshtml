@model SistemaEstoque.Models.ApplicationUserModel

@{
    ViewData["Title"] = "Novo Usuário";
}

<div class="produto-form-page">

    <div class="produto-form-header">
        <div>
            <h1>Novo Usuário</h1>
            <p>Cadastre um novo usuário no sistema.</p>
        </div>

        <a class="btn btn-secondary"
           asp-controller="Usuario"
           asp-action="Index">
            Voltar
        </a>
    </div>

    <div class="produto-form-card">

        <form asp-controller="Usuario"
              asp-action="Adicionar"
              method="post">

            <div class="form-group">
                <label asp-for="NomeCompleto">Nome completo</label>
                <input asp-for="NomeCompleto"
                       class="form-control"
                       placeholder="Digite o nome completo" />
            </div>

            <div class="form-group">
                <label asp-for="UserName">Usuário</label>
                <input asp-for="UserName"
                       class="form-control"
                       placeholder="Digite o usuário" />
            </div>

            <div class="form-group">
                <label asp-for="Email">E-mail</label>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="Digite o e-mail" />
            </div>

            <div class="form-group">
                <label>Senha</label>
                <input name="senha"
                       type="password"
                       class="form-control"
                       placeholder="Digite a senha" />
            </div>

            <div class="form-group">
                <label asp-for="Tipo">Tipo de usuário</label>

                <select asp-for="Tipo" class="form-control">
                    <option value="1">Funcionário</option>
                    <option value="2">Admin</option>
                </select>
            </div>

            <div class="form-actions">

                <a class="btn btn-secondary"
                   asp-controller="Usuario"
                   asp-action="Index">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Adicionar
                </button>

            </div>

        </form>

    </div>

</div>
@model List<SistemaEstoque.Models.ApplicationUserModel>

@{
    ViewData["Title"] = "Usuários";
}

<div class="produto-form-page">

    <div class="produto-form-header">

        <div>
            <h1>Usuários</h1>
            <p>Gerencie os usuários do sistema.</p>
        </div>

        <a class="btn btn-primary"
           asp-controller="Admin"
           asp-action="Adicionar">
            + Adicionar usuário
        </a>

    </div>


    <div class="produto-form-card">

        <table class="table">

            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Usuário</th>
                    <th>E-mail</th>
                    <th>Tipo</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var usuario in Model)
                {
                    <tr>

                        <td>
                            @usuario.NomeCompleto
                        </td>

                        <td>
                            @usuario.UserName
                        </td>

                        <td>
                            @usuario.Email
                        </td>

                        <td>

                            @if (usuario.Tipo == SistemaEstoque.Models.TipoUsuario.Admin)
                            {
                                <span>Administrador</span>
                            }
                            else
                            {
                                <span>Funcionário</span>
                            }

                        </td>

                        <td>

                            <a asp-controller="Admin"
                               asp-action="Excluir"
                               asp-route-id="@usuario.Id"
                               class="btn-excluir"
                               onclick="return confirm('Tem certeza que deseja excluir o usuario @usuario.NomeCompleto?');">
                                Excluir
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
@using SistemaEstoque.Enums

@{
    ViewData["Title"] = "Fazer Movimentação";
}

<div class="produto-form-page">

    <div class="produto-form-header">

        <div>
            <h1>Fazer Movimentação</h1>
            <p>Registre uma entrada, venda ou perda no estoque.</p>
        </div>

        <a class="btn btn-secondary btn-block"
           asp-controller="Movimentacao"
           asp-action="Index">
            Voltar
        </a>

    </div>

    <div class="produto-form-card">

        <form asp-controller="Movimentacao"
              asp-action="Gerar"
              method="post">

            <div asp-validation-summary="All"
                 class="validation">
            </div>

            <div class="form-grid">

                <div class="form-group">

                    <label for="ProdutoId">
                        Produto
                    </label>

                    <select name="ProdutoId"
                            id="ProdutoId"
                            class="form-control"
                            required>

                        <option value="">
                            Selecione um produto...
                        </option>

                        @foreach (var produto in ViewBag.Produtos)
                        {
                            <option value="@produto.Id">
                                @produto.Nome
                            </option>
                        }

                    </select>

                </div>

                <div class="form-group">

                    <label for="Tipo">
                        Tipo de movimentação
                    </label>

                    <select name="Tipo"
                            id="Tipo"
                            class="form-control"
                            required>

                        <option value="">
                            Selecione uma movimentação...
                        </option>

                        <option value="1">
                            Entrada
                        </option>

                        <option value="2">
                            Venda
                        </option>

                        <option value="3">
                            Perda
                        </option>

                    </select>

                </div>

                <div class="form-group">

                    <label for="Quantidade">
                        Quantidade
                    </label>

                    <input type="number"
                           name="Quantidade"
                           id="Quantidade"
                           class="form-control"
                           min="1"
                           required
                           placeholder="Digite a quantidade" />

                </div>

                <div class="form-group"
                     id="campoMotivo"
                     style="display: none;">

                    <label for="Motivo">
                        Motivo da perda
                    </label>

                    <input type="text"
                           name="Motivo"
                           id="Motivo"
                           class="form-control"
                           placeholder="Ex: Produto danificado" />

                </div>

            </div>

            <div class="form-actions">

                <a class="btn btn-secondary btn-block"
                   asp-controller="Movimentacao"
                   asp-action="Index">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-primary btn-block">
                    Registrar movimentação
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <script>

        const tipo = document.getElementById("Tipo");
        const campoMotivo = document.getElementById("campoMotivo");

        tipo.addEventListener("change", function () {

            if (this.value === "3") {
                campoMotivo.style.display = "block";
            }
            else {
                campoMotivo.style.display = "none";
            }

        });

    </script>

}
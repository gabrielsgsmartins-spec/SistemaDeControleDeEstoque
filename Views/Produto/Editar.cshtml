@model SistemaEstoque.Models.ProdutoModel

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="produto-form-page">

    <div class="produto-form-header">
        <div>
            <h1>Novo Produto</h1>
            <p>Cadastre um novo produto no estoque.</p>
        </div>

        <a class="btn btn-secondary btn-block"
           asp-controller="Produto"
           asp-action="Index">
            Voltar
        </a>
    </div>

    <div class="produto-form-card">

        <form asp-controller="Produto"
              asp-action="Adicionar"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation"></div>

            <div class="form-grid">

                <!-- NOME -->
                <div class="form-group">
                    <label asp-for="Nome">
                        Nome do produto
                    </label>

                    <input asp-for="Nome"
                           class="form-control"
                           placeholder="@Model.Nome" />

                    <span asp-validation-for="Nome"
                          class="validation"></span>
                </div>

                <!-- CATEGORIA -->
                <div class="form-group">
                    <label asp-for="Categoria">
                        Categoria
                    </label>

                    <input asp-for="Categoria"
                           class="form-control"
                           type="text"
                           placeholder="@Model.Categoria" />

                    <span asp-validation-for="Categoria"
                          class="validation"></span>
                </div>


                <!-- DESCRIÇÃO -->
                <div class="form-group form-full">
                    <label asp-for="Descricao">
                        Descrição
                    </label>

                    <textarea asp-for="Descricao"
                              class="form-control"
                              rows="4"
                              placeholder="@Model.Descricao"></textarea>

                    <span asp-validation-for="Descricao"
                          class="validation"></span>
                </div>


                <!-- QUANTIDADE EM ESTOQUE -->
                <div class="form-group">
                    <label asp-for="QuantidadeEmEstoque">
                        Quantidade em estoque
                    </label>

                    <input asp-for="QuantidadeEmEstoque"
                           class="form-control"
                           type="number"
                           min="0"
                           placeholder="@Model.QuantidadeEmEstoque" />

                    <span asp-validation-for="QuantidadeEmEstoque"
                          class="validation"></span>
                </div>


                <!-- QUANTIDADE MÍNIMA -->
                <div class="form-group">
                    <label asp-for="QuantidadeMinima">
                        Quantidade mínima
                    </label>

                    <input asp-for="QuantidadeMinima"
                           class="form-control"
                           type="number"
                           min="0"
                           placeholder="@Model.QuantidadeMinima" />

                    <span asp-validation-for="QuantidadeMinima"
                          class="validation"></span>
                </div>


                <!-- PREÇO -->
                <div class="form-group">
                    <label asp-for="PrecoUnitario">
                        Preço unitário
                    </label>

                    <input asp-for="PrecoUnitario"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="@Model.PrecoUnitario" />

                    <span asp-validation-for="PrecoUnitario"
                          class="validation"></span>
                </div>

            </div>


            <!-- BOTÕES -->
            <div class="form-actions">

                <a class="btn btn-secondary btn-block"
                   asp-controller="Produto"
                   asp-action="Index">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-primary btn-block" asp-controller="Produto" asp-action="Index">
                    Editar
                </button>

            </div>

        </form>

    </div>

</div>


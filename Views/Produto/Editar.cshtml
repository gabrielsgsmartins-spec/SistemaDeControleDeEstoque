@model SistemaEstoque.Models.ProdutoModel

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="produto-form-page">

    <div class="produto-form-header">

        <div>
            <h1>Editar Produto</h1>
            <p>Edite as informações do produto.</p>
        </div>

        <a class="btn btn-secondary btn-block"
           asp-controller="Produto"
           asp-action="Index">
            Voltar
        </a>

    </div>

    <div class="produto-form-card">

        <form asp-controller="Produto"
              asp-action="Editar"
              method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="validation">
            </div>

            <div class="form-grid">

                <div class="form-group">

                    <label asp-for="Nome">
                        Nome do produto
                    </label>

                    <input asp-for="Nome"
                           class="form-control" />

                    <span asp-validation-for="Nome"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="CategoriaId">
                        Categoria
                    </label>

                    <select asp-for="CategoriaId"
                            class="form-control">

                        <option value="0">
                            Selecione uma categoria...
                        </option>

                        @foreach (var categoria in ViewBag.Categorias)
                        {
                            <option value="@categoria.Id">
                                @categoria.Nome
                            </option>
                        }

                    </select>

                    <span asp-validation-for="CategoriaId"
                          class="validation">
                    </span>

                </div>


                <div class="form-group form-full">

                    <label asp-for="Descricao">
                        Descrição
                    </label>

                    <textarea asp-for="Descricao"
                              class="form-control"
                              rows="4"></textarea>

                    <span asp-validation-for="Descricao"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="QuantidadeEmEstoque">
                        Quantidade em estoque
                    </label>

                    <input asp-for="QuantidadeEmEstoque"
                           class="form-control"
                           type="number"
                           min="0" />

                    <span asp-validation-for="QuantidadeEmEstoque"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="QuantidadeMinima">
                        Quantidade mínima
                    </label>

                    <input asp-for="QuantidadeMinima"
                           class="form-control"
                           type="number"
                           min="0" />

                    <span asp-validation-for="QuantidadeMinima"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="PrecoUnitario">
                        Preço unitário
                    </label>

                    <input asp-for="PrecoUnitario"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0" />

                    <span asp-validation-for="PrecoUnitario"
                          class="validation">
                    </span>

                </div>

            </div>


            <div class="form-actions">

                <a class="btn btn-secondary btn-block"
                   asp-controller="Produto"
                   asp-action="Index">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-primary btn-block">
                    Editar
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
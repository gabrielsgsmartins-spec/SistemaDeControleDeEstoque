@model SistemaEstoque.Models.ProdutoModel

@{
    ViewData["Title"] = "Excluir Produto";
}
@section Styles {
    <link rel="stylesheet" href="~/css/ProdutoConfirmacao.css" />
}
<div class="confirmacao">

    <h1>Excluir Produto</h1>

    <p>
        Tem certeza que deseja excluir este produto?
    </p>

    <div class="produto-info">

        <h3>@Model.Nome</h3>

        <p>
            <strong>Estoque atual:</strong>
            @Model.QuantidadeEmEstoque
        </p>

    </div>

    <div class="confirmacao-acoes">

        <a asp-controller="Produto"
           asp-action="Index"
           class="btn-cancelar">
            Cancelar
        </a>
        <br />
        <br />
        <br />

        <form asp-controller="Produto"
              asp-action="Excluir"
              method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <button type="submit"
                    class="btn-excluir">
                Excluir produto
            </button>

        </form>

    </div>

</div>
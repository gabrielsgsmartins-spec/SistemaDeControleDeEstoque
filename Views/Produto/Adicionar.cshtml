@model SistemaEstoque.Models.ProdutoModel

@{
    ViewData["Title"] = "Novo Produto";
}

<div class="produto-form-page">

    <div class="produto-form-header">

        <div>
            <h1>Novo Produto</h1>
            <p>Cadastre um novo produto no estoque.</p>
        </div>

        <a class="btn btn-secondary btn-block"
           asp-controller="Produto"
           asp-action="Index">
            Voltar
        </a>

    </div>

    <div class="produto-form-card">

        <form asp-controller="Produto"
              asp-action="Adicionar"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation">
            </div>

            <div class="form-grid">

                <div class="form-group">

                    <label asp-for="Nome">
                        Nome do produto
                    </label>

                    <input asp-for="Nome"
                           class="form-control"
                           placeholder="Digite o nome do produto" />

                    <span asp-validation-for="Nome"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label for="CategoriaId">
                        Categoria
                    </label>

                    <div style="display: flex; gap: 8px;">

                        <select asp-for="CategoriaId"
                                class="form-control">

                            <option value="0">
                                Selecione uma categoria...
                            </option>

                            @foreach (var categoria in ViewBag.Categorias)
                            {
                                <option value="@categoria.Id">
                                    @categoria.Nome
                                </option>
                            }

                        </select>

                        <button type="button"
                                class="btn btn-secondary"
                                onclick="mostrarNovaCategoria()">
                            + Adicionar categoria
                        </button>

                    </div>

                    <div id="novaCategoriaDiv"
                         style="display: none; margin-top: 10px;">

                        <div style="display: flex; gap: 8px;">

                            <input type="text"
                                   id="nomeCategoria"
                                   class="form-control"
                                   placeholder="Nome da nova categoria" />

                            <button type="button"
                                    class="btn btn-primary"
                                    onclick="adicionarCategoria()">
                                Adicionar
                            </button>

                        </div>

                    </div>

                    <span asp-validation-for="CategoriaId"
                          class="validation">
                    </span>

                </div>


                <div class="form-group form-full">

                    <label asp-for="Descricao">
                        Descrição
                    </label>

                    <textarea asp-for="Descricao"
                              class="form-control"
                              rows="4"
                              placeholder="Digite uma descrição do produto"></textarea>

                    <span asp-validation-for="Descricao"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="QuantidadeEmEstoque">
                        Quantidade em estoque
                    </label>

                    <input asp-for="QuantidadeEmEstoque"
                           class="form-control"
                           type="number"
                           min="0"
                           placeholder="0" />

                    <span asp-validation-for="QuantidadeEmEstoque"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="QuantidadeMinima">
                        Quantidade mínima
                    </label>

                    <input asp-for="QuantidadeMinima"
                           class="form-control"
                           type="number"
                           min="0"
                           placeholder="5" />

                    <span asp-validation-for="QuantidadeMinima"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="PrecoUnitario">
                        Preço unitário
                    </label>

                    <input asp-for="PrecoUnitario"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="0,00" />

                    <span asp-validation-for="PrecoUnitario"
                          class="validation">
                    </span>

                </div>

            </div>


            <div class="form-actions">

                <a class="btn btn-secondary btn-block"
                   asp-controller="Produto"
                   asp-action="Index">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-primary btn-block">
                    Adicionar
                </button>

            </div>

        </form>

    </div>

</div>

<script>


    function mostrarNovaCategoria() {

        const div = document.getElementById("novaCategoriaDiv");

        if (div.style.display === "none") {
            div.style.display = "block";
        }
        else {
            div.style.display = "none";
        }
    }

    function adicionarCategoria() {

        const nome = document.getElementById("nomeCategoria").value;

        if (nome.trim() === "") {
            alert("Digite o nome da categoria.");
            return;
        }

        const form = document.createElement("form");

        form.method = "POST";
        form.action = "/Categoria/Adicionar";

        const input = document.createElement("input");

        input.type = "hidden";
        input.name = "nomeCategoria";
        input.value = nome;

        form.appendChild(input);

        document.body.appendChild(form);

        form.submit();
    }

</script>
@model IEnumerable<SistemaEstoque.Models.ProdutoModel>

@{
    ViewData["Title"] = "Produtos";
}
@section Styles {
    <link rel="stylesheet" href="~/css/ProdutoIndex.css" />
}
<div class="produtos-page">

    <div class="produtos-header">

        <div>
            <h1>Produtos</h1>

            <p>
                Gerencie os produtos cadastrados no estoque.
            </p>
        </div>

        <a asp-controller="Produto"
           asp-action="Adicionar"
           class="btn-novo">
            + Novo Produto
        </a>

        <br />
        <br />

    </div>

    <div class="produtos-toolbar">

        <form asp-controller="Produto"
              asp-action="BuscarProduto"
              method="get"
              class="search-box">

            <input type="text"
                   id="id"
                   name="id"
                   placeholder="Pesquisar produto..." />

            <button type="submit" class="btn-novo">
                Buscar
            </button>

        </form>

    </div>



    <div class="table-container">

        <table id="tabelaProdutos">

            <thead>

                <tr>

                    <th>ID</th>

                    <th>Produto</th>

                    <th>Categoria</th>

                    <th>Estoque</th>

                    <th>Preço</th>

                    <th>Status</th>

                    <th>Ações</th>

                </tr>

            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    @foreach (var produto in Model)
                    {
                        <tr>

                            <td>
                                @produto.Id
                            </td>

                            <td>
                                @produto.Nome
                            </td>

                            <td>
                                @(produto.Categoria == null
                                    ? "Sem categoria"
                                    : produto.Categoria.Nome)
                            </td>

                            <td>
                                @produto.QuantidadeEmEstoque
                            </td>

                            <td>
                                R$ @produto.PrecoUnitario.ToString("N2")
                            </td>

                            <td>

                                @if (produto.QuantidadeEmEstoque <= 0)
                                {
                                    <span class="status status-baixo">
                                        Estoque Esgotado
                                    </span>
                                }
                                else if (produto.QuantidadeEmEstoque <= produto.QuantidadeMinima)
                                {
                                    <span class="status status-baixo">
                                        Estoque baixo
                                    </span>
                                }
                                else
                                {
                                    <span class="status status-normal">
                                        Estoque Normal
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="acoes">

                                    <a asp-controller="Produto"
                                       asp-action="Editar"
                                       asp-route-id="@produto.Id"
                                       class="btn-editar">
                                        Editar
                                    </a>

                                    <a asp-controller="Produto"
                                       asp-action="ApagarConfirmacao"
                                       asp-route-id="@produto.Id"
                                       class="btn-excluir"
                                       onclick="return confirm('Tem certeza que deseja excluir o produto @produto.Nome?');">
                                        Excluir
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7">

                            <div class="sem-produtos">

                                <h2>Nenhum produto encontrado</h2>

                                <p>
                                    Cadastre seu primeiro produto para começar.
                                </p>

                                <a asp-controller="Produto"
                                   asp-action="Adicionar"
                                   class="btn-novo">
                                    Novo Produto
                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>